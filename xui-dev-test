#!/bin/bash

# X-UI Development Testing Suite
# Complete testing and debugging utility

BASE_URL="${BASE_URL:-http://localhost:54321}"
BYPASS_HEADER="X-Dev-Bypass: dev-test-bypass-2024"

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

usage() {
    echo "Usage: $0 [command]"
    echo ""
    echo "Commands:"
    echo "  test-api           Test API endpoints"
    echo "  test-frontend      Test frontend components"
    echo "  test-groups        Test group functionality"
    echo "  test-all           Run all tests"
    echo "  get-outbounds      Get list of outbounds"
    echo "  get-subscriptions  Get list of subscriptions"
    echo "  get-groups         Get list of groups"
    echo "  add-outbound       Add a test outbound"
    echo "  clean-test         Remove test outbounds"
    echo "  logs               Show recent logs"
    echo "  status             Check server status"
    echo ""
}

api_call() {
    local method="$1"
    local endpoint="$2"
    local data="$3"
    
    if [ -z "$data" ]; then
        curl -s -X "$method" "$BASE_URL$endpoint" \
            -H "$BYPASS_HEADER" \
            -H "Content-Type: application/json"
    else
        curl -s -X "$method" "$BASE_URL$endpoint" \
            -H "$BYPASS_HEADER" \
            -H "Content-Type: application/json" \
            -d "$data"
    fi
}

case "${1:-test-all}" in
    test-api)
        echo -e "${BLUE}=== API Endpoint Tests ===${NC}"
        echo ""
        
        echo -n "GET /xui/outbound/list: "
        result=$(api_call POST "/xui/outbound/list")
        if echo "$result" | jq -e '.success' > /dev/null 2>&1; then
            echo -e "${GREEN}✓${NC}"
        else
            echo -e "${RED}✗${NC}"
        fi
        
        echo -n "GET /xui/subscription/list: "
        result=$(api_call POST "/xui/subscription/list")
        if echo "$result" | jq -e '.success' > /dev/null 2>&1; then
            echo -e "${GREEN}✓${NC}"
        else
            echo -e "${RED}✗${NC}"
        fi
        
        echo -n "GET /xui/setting/all: "
        result=$(api_call POST "/xui/setting/all")
        if echo "$result" | jq -e '.success' > /dev/null 2>&1; then
            echo -e "${GREEN}✓${NC}"
        else
            echo -e "${RED}✗${NC}"
        fi
        ;;
        
    test-frontend)
        echo -e "${BLUE}=== Frontend Component Tests ===${NC}"
        html=$(curl -s "$BASE_URL/xui/outbounds" -H "$BYPASS_HEADER")
        
        tests=(
            "a-auto-complete:Group autocomplete"
            "openSubscriptionManager:Subscription button"
            "openGroupManager:Group manager"
            "filterGroupOption:Group filter method"
            "testedCount:Tested count computed"
        )
        
        for test in "${tests[@]}"; do
            IFS=':' read -r pattern name <<< "$test"
            echo -n "$name: "
            if echo "$html" | grep -q "$pattern"; then
                echo -e "${GREEN}✓${NC}"
            else
                echo -e "${RED}✗${NC}"
            fi
        done
        ;;
        
    test-groups)
        echo -e "${BLUE}=== Group Functionality Tests ===${NC}"
        
        # Get unique groups
        echo -n "Get unique groups: "
        groups=$(api_call POST "/xui/outbound/list" | jq -r '.obj[]?.groupName' | sort -u)
        if [ -n "$groups" ]; then
            echo -e "${GREEN}✓${NC}"
            echo "  Found groups: $(echo "$groups" | tr '\n' ', ' | sed 's/,$//')"
        else
            echo -e "${RED}✗${NC}"
        fi
        
        # Count outbounds per group
        echo -n "Group distribution: "
        distribution=$(api_call POST "/xui/outbound/list" | jq '.obj | group_by(.groupName) | map({group: .[0].groupName, count: length})')
        if [ -n "$distribution" ]; then
            echo -e "${GREEN}✓${NC}"
            echo "$distribution" | jq -r '.[] | "  \(.group): \(.count) outbound(s)"'
        else
            echo -e "${RED}✗${NC}"
        fi
        
        # Test auto-complete component
        echo -n "Auto-complete component: "
        html=$(curl -s "$BASE_URL/xui/outbounds" -H "$BYPASS_HEADER")
        if echo "$html" | grep -q "a-auto-complete.*uniqueGroups"; then
            echo -e "${GREEN}✓${NC}"
        else
            echo -e "${RED}✗${NC}"
        fi
        ;;
        
    test-all)
        $0 test-api
        echo ""
        $0 test-frontend
        echo ""
        $0 test-groups
        echo ""
        $0 status
        ;;
        
    get-outbounds)
        echo -e "${BLUE}=== Outbounds ===${NC}"
        api_call POST "/xui/outbound/list" | jq '.'
        ;;
        
    get-subscriptions)
        echo -e "${BLUE}=== Subscriptions ===${NC}"
        api_call POST "/xui/subscription/list" | jq '.'
        ;;
        
    get-groups)
        echo -e "${BLUE}=== Groups ===${NC}"
        api_call POST "/xui/outbound/list" | jq -r '.obj[]?.groupName' | sort -u
        ;;
        
    add-outbound)
        echo -e "${BLUE}=== Adding Test Outbound ===${NC}"
        data='{
            "protocol": "vmess",
            "address": "test.example.com",
            "port": 443,
            "settings": "{\"vnext\":[{\"address\":\"test.example.com\",\"port\":443,\"users\":[{\"id\":\"'"$(uuidgen)"'\",\"alterId\":0,\"security\":\"auto\"}]}]}",
            "streamSettings": "{\"network\":\"tcp\",\"security\":\"none\"}",
            "tag": "test-'$(date +%s)'",
            "remark": "Test Outbound '$(date +%H:%M:%S)'",
            "groupName": "test-group"
        }'
        api_call POST "/xui/outbound/add" "$data" | jq '.'
        ;;
        
    clean-test)
        echo -e "${BLUE}=== Cleaning Test Outbounds ===${NC}"
        outbounds=$(api_call POST "/xui/outbound/list" | jq -r '.obj[]? | select(.remark | startswith("Test Outbound")) | .id')
        for id in $outbounds; do
            echo "Deleting outbound ID: $id"
            api_call POST "/xui/outbound/del/$id"
        done
        ;;
        
    logs)
        echo -e "${BLUE}=== Recent Logs ===${NC}"
        docker logs x-ui 2>&1 | tail -30
        ;;
        
    status)
        echo -e "${BLUE}=== Server Status ===${NC}"
        echo -n "Web Server: "
        if curl -s -o /dev/null -w "%{http_code}" "$BASE_URL/xui/outbounds" -H "$BYPASS_HEADER" | grep -q "200"; then
            echo -e "${GREEN}Running${NC}"
        else
            echo -e "${RED}Not responding${NC}"
        fi
        
        echo -n "Authentication Bypass: "
        if [ "$XUI_DEV_MODE" = "true" ] || docker exec x-ui env | grep -q "XUI_DEV_MODE=true"; then
            echo -e "${GREEN}Enabled${NC}"
        else
            echo -e "${YELLOW}Disabled${NC}"
        fi
        ;;
        
    *)
        usage
        exit 1
        ;;
esac
