# X-UI Development Environment Variables
# Copy this file to .env and adjust values as needed

# ============================================
# Application Settings
# ============================================

# Debug mode (true/false)
XUI_DEBUG=true

# Gin framework mode (debug/release/test)
GIN_MODE=debug

# Web server port
XUI_PORT=54321

# ============================================
# Xray Settings
# ============================================

# Force VMESS AEAD encryption (true/false)
XRAY_VMESS_AEAD_FORCED=false

# Xray API port (for management)
XRAY_API_PORT=62789

# ============================================
# Database Settings
# ============================================

# Database path (inside container)
DB_PATH=/etc/x-ui/x-ui.db

# Database backup directory
DB_BACKUP_PATH=/etc/x-ui/backups

# ============================================
# Development Settings
# ============================================

# Enable CGO (required for SQLite)
CGO_ENABLED=1

# Go build flags (for Air hot-reload)
GO_BUILD_FLAGS=-buildvcs=false

# Air delay (milliseconds before rebuild)
AIR_DELAY=1000

# ============================================
# Timezone
# ============================================
TZ=Asia/Tehran

# ============================================
# Default Credentials (CHANGE IN PRODUCTION!)
# ============================================
# Default: admin/admin
# Change immediately after first login!

# ============================================
# Outbound Management Settings
# ============================================

# Outbound test interval (cron format)
OUTBOUND_TEST_INTERVAL=@every 4h

# Outbound cleanup days threshold
OUTBOUND_CLEANUP_DAYS=7

# Auto-routing interval
OUTBOUND_AUTO_ROUTE_INTERVAL=@every 4h

# ============================================
# Host Network Settings
# ============================================
# Using host network mode for simplicity in development
# In production, consider using bridge mode with proper port mapping
